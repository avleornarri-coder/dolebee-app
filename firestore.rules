rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isOwner() { return signedIn() && role() == 'owner'; }
    function isRider() { return signedIn() && role() == 'rider'; }

    // Set once, when the owner account is created.
    match /config/store {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      // The first owner, in the same write as config/store.
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'owner'
                    && getAfter(/databases/$(database)/documents/config/store).data.ownerUid == uid;
      // The owner adds and edits delivery staff.
      allow create, update: if isOwner() && request.resource.data.role == 'rider';
    }

    match /menu/{itemId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /orders/{orderId} {
      // Customers (signed in without an account) place their own orders.
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid
                    && request.resource.data.status in ['received', 'awaitingPayment'];
      allow read: if signedIn() && (resource.data.customerUid == request.auth.uid
                    || isOwner()
                    || (isRider() && resource.data.riderId == request.auth.uid));
      allow update: if isOwner()
                    || (isRider() && resource.data.riderId == request.auth.uid
                        && request.resource.data.riderId == request.auth.uid);
    }
  }
}
